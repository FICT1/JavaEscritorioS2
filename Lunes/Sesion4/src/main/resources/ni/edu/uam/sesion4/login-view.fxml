<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="332.0" prefWidth="389.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sesion4.LoginController">

   <Label text="Login">
      <padding>
         <Insets bottom="5.0" top="5.0" />
      </padding>
      <font>
         <Font size="18.0" />
      </font></Label>
   <Label text="Usuario:" />
   <TextField fx:id="txtUser" />
   <Label layoutX="108.0" layoutY="180.0" text="Contraseña:" />
   <TextField fx:id="txtPassword" layoutX="20.0" layoutY="199.0" />
   <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#loginButtonAction" prefHeight="43.0" prefWidth="100.0" text="Iniciar Sesión" />
   <padding>
      <Insets bottom="15.0" left="10.0" right="15.0" top="15.0" />
   </padding>


</VBox>
